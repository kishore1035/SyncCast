    <Color x:Key="RailBgColor">#161618</Color>
    <Color x:Key="SurfaceDarkColor">#202024</Color>
    <Color x:Key="SurfacePanelColor">#25252A</Color>
    <Color x:Key="SurfaceCardColor">#2A2A30</Color>
