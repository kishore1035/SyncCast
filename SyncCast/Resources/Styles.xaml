    <Color x:Key="InputBgColor">#2E2E35</Color>

    <Color x:Key="AccentCyanColor">#00A3D9</Color>
    <Color x:Key="AccentCyanDarkColor">#0086B3</Color>
    <Color x:Key="AccentGlowColor">#2600A3D9</Color>

    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
